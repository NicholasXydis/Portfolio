/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data:; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval' __INLINE_SCRIPT_HASHES__ https://us-assets.i.posthog.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://us.i.posthog.com https://us-assets.i.posthog.com https://cloudflareinsights.com; worker-src 'self' blob:; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin

/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/en
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/en/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/fr
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/fr/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/cv-en.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Robots-Tag: noindex

/cv-fr.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Robots-Tag: noindex

/cv-en.pdf
  X-Robots-Tag: noindex

/cv-fr.pdf
  X-Robots-Tag: noindex

/404
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Robots-Tag: noindex

/404.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Robots-Tag: noindex

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/worlds/*
  Cache-Control: public, max-age=31536000, immutable
