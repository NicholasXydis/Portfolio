{
  "name": "portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "validate:content": "vite-node scripts/validateContent.ts",
    "build": "npm run validate:content && tsc -b && vite build && npm run generate:sitemap && npm run prerender",
    "generate:sitemap": "vite-node scripts/generateSitemap.ts",
    "prerender": "vite-node scripts/prerender.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "i18next": "^26.7.2",
    "posthog-js": "^1.450.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-router": "^8.5.1",
    "three": "^0.187.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "minimatch": "^11.0.1",
    "postcss-selector-parser": "^7.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  }
}
